<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_material_issue_slip_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.html_container">
                    <table width="100%" style="border:0px solid #000;">

                            <!-- HEADER ROW -->
                            <tr>
                                <!-- LOGO -->
                                <td style="border:0px solid #000; width:25%;">
                                    <img t-if="o.company_id.logo"
                                         t-att-src="image_data_uri(o.company_id.logo)"
                                         style="max-height:60px;"/>
                                </td>

                                <!-- TITLE -->
                                <td style="border:0px solid #000; width:50%; text-align:center; font-weight:600;font-size:20px" >
                                    Material Issue Slip
                                </td>

                                <!-- DOC INFO -->
                                <td style="border:0px solid #000; width:25%; padding:6px;font-size:10px; line-height:14px;">

                                </td>

                            </tr>
                        </table>
                    <div style="text-align: right;font-size: 10px;">
                        (<span>Doc No:</span>
                        <span t-field="o.doc_no"/>

                        <span>Rev No:</span>
                        <span t-field="o.revision_no"/>

                        <span>Rev Date:</span>
                        <t t-if="o.revision_date">
                            <span t-field="o.revision_date"/>
                        </t>
                        <t t-else="">
                            <span>-</span>
                        </t>)
                    </div>

                    <div class="page" style="padding-top:0;">
<!--                        <table style="width:100%; border-collapse:collapse; table-layout:fixed; color:#1b2a41; margin-top:-1px;">-->
<!--                            <tr>-->
<!--                                <td style="width:13%; border:1px solid #223047; padding:12px 6px; font-weight:700;">Requisition Date:</td>-->
<!--                                <td style="width:39%; border:1px solid #223047; padding:12px 6px;">-->
<!--                                    <span t-esc="o.scheduled_date and o.scheduled_date.strftime('%d.%m.%Y') or ''"/>-->
<!--                                </td>-->
<!--                                <td style="width:18%; border:1px solid #223047; padding:12px 6px; font-weight:700;">Project Name:</td>-->
<!--                                <td style="width:30%; border:1px solid #223047; padding:12px 6px;">-->
<!--                                    <span t-esc="o.project_id.name or o.origin or ''"/>-->
<!--                                </td>-->
<!--                            </tr>-->
<!--                            <tr>-->
<!--                                <td style="border:1px solid #223047; padding:12px 6px; font-weight:700;">Requisition by:</td>-->
<!--                                <td style="border:1px solid #223047; padding:12px 6px;">-->
<!--&lt;!&ndash;                                    <span t-esc="o.material_requested_by_id.name or ''"/>&ndash;&gt;-->
<!--                                </td>-->
<!--                                <td style="border:1px solid #223047; padding:12px 6px; font-weight:700;">Material recieved By:</td>-->
<!--                                <td style="border:1px solid #223047; padding:12px 6px;">-->
<!--&lt;!&ndash;                                    <span t-esc="o.material_received_by_id.name or ''"/>&ndash;&gt;-->
<!--                                </td>-->
<!--                            </tr>-->
<!--                        </table>-->

                        <table style="width:100%; border-collapse:collapse; table-layout:fixed; color:#1b2a41; margin-top:-1px;">
                            <tr>
                                <td style="border:1px solid #223047;padding:8px 6px; font-weight:500;">Requisition Date:</td>
                                <td colspan="2" style="border:1px solid #223047;padding:8px 6px; font-weight:500;">
                                    <span t-field="o.scheduled_date"/>
                                </td>
                                <td style="border:1px solid #223047;padding:8px 6px; font-weight:500;">Project Name:</td>
                                <td colspan="2" style="border:1px solid #223047;padding:8px 6px; font-weight:500;">
                                    <span t-field="o.project_id"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="border:1px solid #223047;padding:8px 6px; font-weight:500;">Requisition by:</td>
                                <td colspan="2" style="border:1px solid #223047;padding:8px 6px; font-weight:500;">
                                </td>
                                <td style="border:1px solid #223047;padding:8px 6px; font-weight:500;">Material recieved By:</td>
                                <td colspan="2" style="border:1px solid #223047;padding:8px 6px; font-weight:500; ">
                                </td>
                            </tr>
                            <tr>
                                <th style="width:7%; border:1px solid #223047; padding:8px 6px; font-weight:500; text-align:center;">Sr.no.</th>
                                <th style="width:25%; border:1px solid #223047; padding:8px 6px; font-weight:500; text-align:center;">Material Description</th>
                                <th style="width:14%; border:1px solid #223047; padding:8px 6px; font-weight:500; text-align:center;">Required Qty.</th>
                                <th style="width:14%; border:1px solid #223047; padding:8px 6px; font-weight:500; text-align:center;">Issue Qty.</th>
                                <th style="width:17%; border:1px solid #223047; padding:8px 6px; font-weight:500; text-align:center;">Remarks</th>
                                <th style="width:23%; border:1px solid #223047; padding:8px 6px; font-weight:500; text-align:center;">Material Issued By</th>
                            </tr>
                            <t t-set="sr" t-value="1"/>
                            <t t-foreach="o.move_ids_without_package" t-as="line">
                                <tr>
                                    <td style="border:1px solid #223047; padding:8px 6px; text-align:center; height:32px;">
                                        <span t-esc="sr"/>
                                    </td>
                                    <td style="border:1px solid #223047; padding:8px 6px;">
                                        <span t-field="line.product_id"/>
                                    </td>
                                    <td style="border:1px solid #223047; padding:8px 6px; text-align:center;">
                                        <span t-field="line.product_uom_qty"/>
                                    </td>
                                    <td style="border:1px solid #223047; padding:8px 6px; text-align:center;">
                                        <span t-field="line.quantity"/>
                                    </td>
                                    <td style="border:1px solid #223047; padding:8px 6px;">
<!--                                            <span t-esc="line.remark or ''"/>-->
                                    </td>
                                    <td style="border:1px solid #223047; padding:8px 6px;">
<!--                                            <span t-esc="line.material_issued_by_id.name or ''"/>-->
                                    </td>
                                </tr>
                                <t t-set="sr" t-value="sr + 1"/>
                            </t>
                        </table>

                        <table style="width:100%; border-collapse:collapse; table-layout:fixed; color:#1b2a41; margin-top:-1px;">
                            <tr>
                                <td style="width:50%; border:1px solid #223047; height:58px; text-align:center; vertical-align:bottom; padding-bottom:10px; font-size:14px; font-weight:700;">
                                    Requester Signature
                                </td>
                                <td style="width:50%; border:1px solid #223047; height:58px; text-align:center; vertical-align:bottom; padding-bottom:10px; font-size:14px; font-weight:700;">
                                    Store Person Signature
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
